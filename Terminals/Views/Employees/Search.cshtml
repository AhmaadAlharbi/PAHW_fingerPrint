@model Terminals.Web.DTOs.EmployeeDevicesScreenDto?
@{
ViewData["Title"] = "بحث موظف";
var toastType      = TempData["ToastType"] as string;
var toastMsg       = TempData["ToastMsg"]  as string;
var lastEmployeeId = TempData["LastEmployeeId"]?.ToString();
var isAdmin        = Context.Session.GetString("IsAdmin") == "1";
var employee       = Model?.Employee;
var devices        = Model?.Devices ?? new List<Terminals.Web.DTOs.DeviceRowDto>();
var regionGroups   = Model?.RegionGroups;
var assigned       = devices.Where(x => x.IsEffectivelyAssigned).ToList();
}

@section Styles {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
<style>
    .employees-search-page { padding-bottom: 170px; }

    .search-search-card,
    .search-workspace-card {
        max-width: 1320px;
        margin-inline: auto;
    }

    .search-search-card {
        padding-block: 22px;
    }

    .search-strip {
        display: grid;
        grid-template-columns: minmax(0, 1fr);

        gap: 18px;
        align-items: end;
        margin-bottom: 18px;
    }
    .search-strip-copy h1 {
        margin: 0 0 4px;
        font-size: 1.35rem;
        font-weight: 800;
        color: #2e3238;
    }
    .search-strip-copy p {
        margin: 0;
        color: #6b7280;
        font-size: 13px;
    }
    .search-form-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 10px;
        align-items: end;
    }
    .search-form-grid .btn { min-width: 118px; }

    .workspace-divider { margin: 20px 0; }

    .empty-inline {
        color: #6b7280;
        font-size: 14px;
        padding: 4px 0 0;
    }

    .employee-strip {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(260px, 1fr);
        gap: 16px;
        align-items: center;
        padding: 14px 16px;
        border: 1px solid var(--gray-200);
        border-radius: 14px;
        background: #fbf9f8;
        margin-bottom: 16px;
    }
    .employee-strip-main { min-width: 0; }
    .employee-strip-name {
        font-size: 1.05rem;
        font-weight: 800;
        color: #2f3338;
        margin-bottom: 4px;
    }
    .employee-strip-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        color: #6b7280;
        font-size: 13px;
    }
    .employee-strip-meta strong {
        color: #692f39;
        font-weight: 800;
    }
    .employee-strip-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
    }
    .employee-summary-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        border-radius: 999px;
        background: #fff;
        border: 1px solid #e6ded8;
        color: #4b5563;
        font-size: 12.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    .action-panel {
        display: grid;
        gap: 10px;
        margin-bottom: 16px;
    }
    .action-panel-title {
        margin: 0;
    }
    .action-options {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
    }
    .action-option {
        position: relative;
    }
    .action-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }
    .action-option-label {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        border-radius: 10px;
        border: 1.5px solid #e2dbd7;
        background: #fff;
        color: #374151;
        font-size: 13.5px;
        font-weight: 800;
        cursor: pointer;
        transition: border-color .15s ease, background .15s ease, box-shadow .15s ease;
        text-align: center;
        padding: 10px 12px;
    }
    .action-option input:checked + .action-option-label {
        border-color: #692f39;
        background: #f8f1f2;
        color: #692f39;
        box-shadow: 0 0 0 3px rgba(105, 47, 57, .08);
    }
    .action-option input:focus-visible + .action-option-label,
    .action-option-label:focus-visible {
        outline: none;
        box-shadow: 0 0 0 3px rgba(105, 47, 57, .16);
    }
    .action-help {
        color: #6b7280;
        font-size: 13px;
        min-height: 20px;
    }
    .search-bulk-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
        flex-wrap: wrap;
    }
    .search-bulk-heading .btn-group-sm { display: flex; gap: 8px; }

    .delegate-inline {
        display: none;
        grid-template-columns: repeat(2, minmax(0, 220px));
        gap: 12px;
        align-items: start;
    }
    .delegate-inline.is-visible { display: grid; }
    .delegate-field label {
        display: block;
        margin-bottom: 6px;
        color: #6b5b57;
        font-size: 12px;
        font-weight: 700;
    }
    .delegate-input-wrap {
        position: relative;
    }
    .delegate-input-wrap i {
        position: absolute;
        inset-inline-start: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #8b929b;
        font-size: 13px;
        pointer-events: none;
    }
    .delegate-field .form-control {
        min-height: 44px;
        border: 1px solid #cdbdb7;
        border-radius: 10px;
        background: #fff;
        padding-inline-start: 36px;
        font-weight: 700;
        color: #2f3338;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.6);
    }
    .delegate-field .form-control::placeholder {
        color: #9ca3af;
        font-weight: 500;
    }
    .delegate-field .form-control:focus {
        border-color: #692f39;
        box-shadow: 0 0 0 3px rgba(105, 47, 57, .08);
    }
    .delegate-validation {
        grid-column: 1 / -1;
        color: #8a6116;
        font-size: 12px;
    }
    .delegate-validation.is-valid { color: #166534; }
    .delegate-validation.is-hidden { display: none; }

    .toolbar-row {
        display: grid;
        grid-template-columns: minmax(220px, 280px) minmax(200px, 240px) minmax(0, 1fr);
        gap: 10px;
        align-items: center;
        margin-bottom: 12px;
    }
    .region-select-wrap,
    .toolbar-filter-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        border: 1px solid #ddd5d0;
        border-radius: 10px;
        padding: 0 12px;
    }
    .region-select {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        width: 100%;
        border: none;
        background: transparent;
        padding: 11px 2px;
        outline: none;
        font-size: 13px;
        color: #374151;
    }
    .toolbar-filter-wrap .region-select {
        font-weight: 600;
    }
    .toolbar-search {
        position: relative;
    }
    .toolbar-search i {
        position: absolute;
        inset-inline-start: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #8b929b;
        font-size: 13px;
    }
    .toolbar-search input {
        padding-inline-start: 36px;
    }

    .workspace-note {
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 12px;
    }
    .workspace-note.is-warning {
        color: #8a6116;
        background: #fbf5ea;
        border: 1px solid #eddcbc;
        border-radius: 10px;
        padding: 10px 12px;
    }

    .regions-list {
        display: grid;
        gap: 12px;
    }
    .region-card {
        border: 1px solid var(--gray-200);
        border-radius: 14px;
        overflow: hidden;
        background: #fff;
    }
    .region-header {
        width: 100%;
        border: none;
        background: #faf9f8;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        text-align: inherit;
        cursor: pointer;
    }
    .region-header:focus-visible {
        outline: none;
        box-shadow: inset 0 0 0 2px rgba(105, 47, 57, .2);
    }
    .region-title {
        font-size: 15px;
        font-weight: 800;
        color: #2f3338;
        margin-bottom: 3px;
    }
    .region-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 12px;
        color: #6b7280;
        font-size: 12px;
    }
    .region-chevron {
        color: #8b929b;
        transition: transform .15s ease;
        flex-shrink: 0;
    }
    .region-header[aria-expanded="true"] .region-chevron {
        transform: rotate(180deg);
    }
    .region-body {
        display: none;
        padding: 14px 16px 16px;
        border-top: 1px solid #efe8e4;
    }
    .region-body.show { display: block; }
    .region-tools {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 12px;
    }
    .region-select-all {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #374151;
    }
    .region-inline-action { margin-inline-start: auto; }

    .devices-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }
    .device-card {
        border: 1px solid var(--gray-200);
        border-radius: 12px;
        padding: 12px;
        background: #fff;
        transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
    }
    .device-card.is-interactive {
        cursor: pointer;
    }
    .device-card.is-interactive:hover {
        border-color: #cdbfc2;
    }
    .device-card.is-selected {
        border-color: #692f39;
        background: #fbf4f5;
        box-shadow: 0 0 0 3px rgba(105, 47, 57, .08);
    }
    .device-card.is-disabled {
        background: #fbfbfb;
    }
    .device-card.is-disabled .device-card-content {
        opacity: .76;
    }
    .device-card:focus-visible {
        outline: none;
        box-shadow: 0 0 0 3px rgba(105, 47, 57, .16);
    }
    .device-card-layout {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 10px;
        align-items: start;
    }
    .device-check {
        margin-top: 2px;
    }
    .device-topline {
        display: flex;
        align-items: start;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 6px;
    }
    .device-name {
        font-size: 14px;
        font-weight: 800;
        color: #2f3338;
        line-height: 1.35;
        margin-bottom: 2px;
    }
    .device-id {
        color: #6b7280;
        font-size: 12px;
    }
    .device-badge {
        flex-shrink: 0;
        border-radius: 999px;
        padding: 5px 10px;
        font-size: 11.5px;
        font-weight: 800;
        white-space: nowrap;
    }
    .device-badge.is-unassigned {
        background: #f3f4f6;
        color: #4b5563;
    }
    .device-badge.is-assigned {
        background: #edf7f1;
        color: #166534;
    }
    .device-badge.is-delegated-active {
        background: #fff4df;
        color: #9a6700;
    }
    .device-badge.is-delegated-scheduled {
        background: #eef4ff;
        color: #1d4ed8;
    }
    .device-note {
        color: #8b5e19;
        font-size: 11.5px;
        margin-top: 4px;
    }
    .region-empty,
    .page-empty {
        color: #6b7280;
        font-size: 13px;
        padding: 10px 0 2px;
    }
    .page-empty {
        border-top: 1px solid #eee7e3;
        margin-top: 14px;
    }

    .bulk-bar {
        display: none;
        position: fixed;
        left: 50%;
        transform: translateX(-50%);
        bottom: 18px;
        z-index: 40;
        width: min(1320px, calc(100% - 32px));
        max-width: calc(100% - 32px);
        box-sizing: border-box;
        padding: 12px 14px;
        border: 1px solid #e7ddd8;
        border-inline-start: 4px solid var(--maroon);
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 14px 34px rgba(17, 24, 39, .12);
    }
    .bulk-bar.show {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }
    .bulk-bar-main {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
        flex: 1 1 auto;
    }
    .bulk-bar-count {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background: var(--maroon);
        color: #fff;
        font-weight: 800;
        font-size: 15px;
        flex-shrink: 0;
    }
    .bulk-bar-copy {
        min-width: 0;
    }
    .bulk-bar-label {
        font-size: 13px;
        color: #6b7280;
    }
    .bulk-bar-title {
        font-size: 15px;
        font-weight: 800;
        color: #1f2937;
    }
    .bulk-bar-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }
    .bulk-bar-actions .btn {
        white-space: nowrap;
    }
    .bulk-bar-actions .btn-outline {
        min-width: 124px;
    }
    .bulk-bar-actions .btn-primary {
        min-width: 220px;
        font-weight: 800;
        box-shadow: 0 8px 20px rgba(105, 47, 57, .18);
    }

    @@media (max-width: 1279.98px) {
        .devices-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 991.98px) {
        .search-strip,
        .employee-strip,
        .toolbar-row {
            grid-template-columns: 1fr;
        }
        .employee-strip-summary {
            justify-content: flex-start;
        }
        .action-options {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .devices-grid {
            grid-template-columns: 1fr;
        }
        .delegate-inline {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 767.98px) {
        .page-surface {
            padding: 16px;
            border-radius: 14px;
        }
        .search-form-grid,
        .delegate-inline {
            grid-template-columns: 1fr;
        }
        .action-options {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .region-tools {
            align-items: flex-start;
        }
        .bulk-bar.show {
            bottom: 12px;
            width: calc(100% - 24px);
            max-width: calc(100% - 24px);
            flex-direction: column;
            align-items: stretch;
        }
        .bulk-bar-actions {
            width: 100%;
        }
        .bulk-bar-actions .btn {
            flex: 1 1 0;
        }
    }

    @@media (max-width: 480px) {
        .action-options {
            grid-template-columns: 1fr 1fr;
        }
        .action-option-label {
            min-height: 44px;
            font-size: 12.5px;
            padding: 8px 10px;
        }
        .device-topline {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
}

<div class="employees-search-page"
     data-employee-id="@(Model?.Employee?.EmployeeId ?? 0)"
     data-employee-name="@(Model?.Employee?.FullNameAr ?? "")">

    @if (!string.IsNullOrWhiteSpace(toastMsg))
    {
    var alertClass = toastType switch {
    "success" => "alert-success",
    "danger"  => "alert-danger",
    "warning" => "alert-warning",
    _         => "alert-info"
    };
    <div class="alert @alertClass d-flex align-items-center gap-2 mb-3" role="alert">
        @if (toastType == "success") { <i class="fa-solid fa-circle-check"></i> }
        else if (toastType == "danger") { <i class="fa-solid fa-circle-xmark"></i> }
        else if (toastType == "warning") { <i class="fa-solid fa-triangle-exclamation"></i> }
        else { <i class="fa-solid fa-circle-info"></i> }
        <span>@toastMsg</span>
    </div>
    }

    <div class="content-card fade-in search-search-card">
        <div class="search-strip">
            <div class="search-strip-copy">
                <h1 class="c-section-title mb-0">إدارة أجهزة الموظف</h1>
                <p>ابحث عن الموظف ثم راجع المناطق والأجهزة قبل اختيار العملية المناسبة.</p>
            </div>
            <form id="employeeSearchForm" method="post" asp-controller="Employees" asp-action="SearchPost">
                @Html.AntiForgeryToken()
                <div class="search-form-grid">
                    <div>
                        <label class="form-label fw-bold">الرقم الوظيفي</label>
                        <input type="number" name="employeeId" class="form-control"
                               placeholder="مثال: 7300"
                               value="@(Model?.Employee?.EmployeeId.ToString() ?? lastEmployeeId ?? "")"
                               required />
                    </div>
                    <button type="submit" class="btn btn-primary u-nowrap">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <span>بحث</span>
                    </button>
                </div>
            </form>
        </div>

        <div id="recentEmployees" class="recent-chips mb-2" style="display:none"></div>
    </div>

    @if (employee == null)
    {
    <div class="search-workspace-card content-card fade-in mt-3">
        <div class="empty-inline">أدخل الرقم الوظيفي لعرض الموظف ومناطقه وأجهزة البصمة المرتبطة به.</div>
    </div>
    }
    else
    {
    var assignedRegionCount = regionGroups?.Count(g => g.Devices.Any(x => x.IsEffectivelyAssigned)) ?? 0;
    var hasActiveDelegation = devices.Any(x => x.IsDelegatedActive);
    <div class="search-workspace-card content-card fade-in mt-3">
        <div class="employee-strip">
            <div class="employee-strip-main">
                <div class="employee-strip-name">@employee.FullNameAr</div>
                <div class="employee-strip-meta">
                    <span><strong>@employee.EmployeeId</strong></span>
                    @if (!string.IsNullOrWhiteSpace(employee.Department))
                    {
                        <span>@employee.Department</span>
                         
                    }
                  
                    @if (!string.IsNullOrWhiteSpace(employee.JobTitle))
                    {
                    <span>@employee.JobTitle</span>
                    }
                </div>
            </div>
            <div class="employee-strip-summary">
                <span class="employee-summary-pill">@assigned.Count جهاز مرتبط</span>
                <span class="employee-summary-pill">@assignedRegionCount منطقة مرتبطة</span>
                @if (hasActiveDelegation)
                {
                <span class="employee-summary-pill">يوجد ندب نشط</span>
                }
            </div>
        </div>

        <div class="divider workspace-divider"></div>

        <div class="action-panel">
            <h2 class="c-section-title action-panel-title">اختر من الخيارات التالية</h2>
            <div class="action-options" role="radiogroup" aria-label="اختر العملية المطلوبة">
                <label class="action-option">
                    <input type="radio" name="pageAction" value="attach" />
                    <span class="action-option-label">تفعيل البصمة</span>
                </label>
                <label class="action-option">
                    <input type="radio" name="pageAction" value="delegate" />
                    <span class="action-option-label">ندب مؤقت</span>
                </label>
                <label class="action-option">
                    <input type="radio" name="pageAction" value="end-delegation" />
                    <span class="action-option-label">إلغاء ندب</span>
                </label>
                <label class="action-option">
                    <input type="radio" name="pageAction" value="detach" />
                    <span class="action-option-label">إلغاء ربط</span>
                </label>
            </div>
            <div id="actionHelpText" class="action-help">اختر العملية المطلوبة لتحديد الأجهزة.</div>
            <div id="delegateInlineFields" class="delegate-inline" aria-hidden="true">
                <div class="delegate-field">
                    <label for="bulkStartDate">من تاريخ</label>
                    <div class="delegate-input-wrap">
                        <i class="fa-regular fa-calendar"></i>
                        <input id="bulkStartDate" type="text" class="form-control datepicker" placeholder="02/08/2026" autocomplete="off" />
                    </div>
                </div>
                <div class="delegate-field">
                    <label for="bulkEndDate">إلى تاريخ</label>
                    <div class="delegate-input-wrap">
                        <i class="fa-regular fa-calendar"></i>
                        <input id="bulkEndDate" type="text" class="form-control datepicker" placeholder="03/08/2026" autocomplete="off" />
                    </div>
                </div>
                <div id="delegateValidation" class="delegate-validation">يرجى اختيار تاريخ بداية الندب وتاريخ نهايته.</div>
            </div>
        </div>

        @if (regionGroups != null && regionGroups.Any())
        {
        <div class="search-bulk-heading">
            <h2 class="c-section-title mb-0">المناطق والأجهزة</h2>
            <div class="btn-group-sm">
                <button type="button" class="btn btn-outline btn-sm u-nowrap" id="expandRegionsBtn">فتح الكل</button>
                <button type="button" class="btn btn-outline btn-sm u-nowrap" id="collapseRegionsBtn">إغلاق الكل</button>
            </div>
        </div>

        <div class="toolbar-row">
            <div class="region-select-wrap">
                <i class="fa-solid fa-location-dot text-maroon"></i>
                <select id="regionSelect" class="region-select" aria-label="اختر المنطقة">
                    <option value="all">كل المناطق (@devices.Count)</option>
                    @foreach (var g in regionGroups)
                    {
                    <option value="@g.RegionName">@g.RegionName (@g.TotalDevices)</option>
                    }
                </select>
                <i class="fa-solid fa-chevron-down text-muted"></i>
            </div>
            <div class="toolbar-filter-wrap">
                <i class="fa-solid fa-link text-maroon"></i>
                <select id="deviceScopeSelect" class="region-select" aria-label="فلترة حسب ارتباط الموظف">
                    <option value="all">كل الأجهزة</option>
                    <option value="linked">الأجهزة المرتبطة بالموظف</option>
                </select>
                <i class="fa-solid fa-chevron-down text-muted"></i>
            </div>
            <div class="toolbar-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="deviceLiveSearch" class="form-control" placeholder="ابحث باسم الجهاز أو رقمه" />
            </div>
        </div>

        <div id="workspaceNote" class="workspace-note is-warning">اختر العملية المطلوبة لتحديد الأجهزة.</div>
        <div id="bulkBar" class="bulk-bar" aria-live="polite">
            <div class="bulk-bar-main">
                <div class="bulk-bar-count" id="selectedCount">0</div>
                <div class="bulk-bar-copy">
                    <div class="bulk-bar-title" id="bulkTitle">لا توجد أجهزة محددة</div>
                    <div class="bulk-bar-label" id="bulkLabel">اختر العملية ثم حدّد الأجهزة المناسبة لها.</div>
                </div>
            </div>
            <div class="bulk-bar-actions">
                <button id="bulkClearSelectionBtn" type="button" class="btn btn-outline">إلغاء التحديد</button>
                <button id="bulkExecuteBtn" type="button" class="btn btn-primary">تنفيذ العملية</button>
            </div>
        </div>

        <div class="regions-list" id="regionsList">
            @for (int i = 0; i < regionGroups.Count; i++)
            {
            var g = regionGroups[i];
            var collapseId = $"regionCollapse_{i}";
            var regionKey = $"region_{i}";
            var activeDelegationTerminalIds = g.Devices
            .Where(x => x.IsDelegatedActive && !string.IsNullOrWhiteSpace(x.DeviceId))
            .Select(x => x.DeviceId!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
            <section class="region-card" data-region-name="@g.RegionName">
                <button type="button"
                        class="region-header"
                        data-collapse-target="@collapseId"
                        aria-expanded="@(i == 0 ? "true" : "false")">
                    <div>
                        <div class="region-title">@g.RegionName</div>
                        <div class="region-meta">
                            <span>@g.TotalDevices جهاز</span>
                            <span data-region-available>0 متاح</span>
                        </div>
                    </div>
                    <i class="fa-solid fa-chevron-down region-chevron"></i>
                </button>

                <div id="@collapseId" class="region-body @(i == 0 ? "show" : "")">
                    <div class="region-tools">
                        <label class="region-select-all" for="selectAll_@regionKey">
                            <input class="form-check-input select-all-region" type="checkbox" id="selectAll_@regionKey" />
                            <span data-select-all-label>تحديد جميع الأجهزة المتاحة (0)</span>
                        </label>

                        @if (activeDelegationTerminalIds.Count > 0)
                        {
                        <div class="region-inline-action">
                            <form method="post" asp-controller="Employees" asp-action="EndDelegation" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="employeeId" value="@employee.EmployeeId" />
                                @foreach (var terminalId in activeDelegationTerminalIds)
                                {
                                <input type="hidden" name="terminalIds" value="@terminalId" />
                                }
                                @* <button type="button" class="btn btn-danger btn-sm" data-delegation-scope="region"> *@
                                @*     إلغاء الندب النشط للمنطقة *@
                                @* </button> *@
                            </form>
                        </div>
                        }
                    </div>

                    @if (g.Devices.Any())
                    {
                    <div class="devices-grid">
                        @foreach (var d in g.Devices)
                        {
                        var terminalId = (d.DeviceId ?? "").Trim();
                        var stateText =
                        d.IsDelegatedActive ? "ندب نشط"
                        : (d.IsDelegated && d.DelegationStatus == "Scheduled") ? "ندب مجدول"
                        : d.IsAssigned ? "مرتبط دائمًا"
                        : "غير مرتبط";

                        var stateClass =
                        d.IsDelegatedActive ? "is-delegated-active"
                        : (d.IsDelegated && d.DelegationStatus == "Scheduled") ? "is-delegated-scheduled"
                        : d.IsAssigned ? "is-assigned"
                        : "is-unassigned";

                        var stateKey =
                        d.IsDelegatedActive ? "delegated_active"
                        : (d.IsDelegated && d.DelegationStatus == "Scheduled") ? "delegated_scheduled"
                        : d.IsAssigned ? "assigned"
                        : "unassigned";

                        <article class="device-card"
                                 data-state-key="@stateKey"
                                 data-terminal-id="@terminalId"
                                 data-device-name="@d.DeviceName"
                                 data-region-name="@g.RegionName"
                                 data-delegation-id="@(d.DelegationId?.ToString() ?? "")"
                                 data-delegation-start="@(d.DelegationStartDate?.ToString("dd/MM/yyyy") ?? "")"
                                 data-delegation-end="@(d.DelegationEndDate?.ToString("dd/MM/yyyy") ?? "")">
                            <div class="device-card-layout">
                                <div class="device-check">
                                    <input type="checkbox"
                                           class="form-check-input device-chk"
                                           id="chk_@(regionKey)_@(terminalId)"
                                           value="@terminalId"
                                           disabled />
                                </div>
                                <div class="device-card-content">
                                    <div class="device-topline">
                                        <div>
                                            <div class="device-name">@d.DeviceName</div>
                                            <div class="device-id">@(string.IsNullOrWhiteSpace(terminalId) ? "بدون رقم جهاز" : terminalId)</div>
                                        </div>
                                        <span class="device-badge @stateClass">@stateText</span>
                                    </div>
                                    <div class="device-note is-hidden" data-device-note></div>
                                </div>
                            </div>
                        </article>
                        }
                    </div>
                    }
                    else
                    {
                    <div class="region-empty">لا توجد أجهزة في هذه المنطقة.</div>
                    }
                </div>
            </section>
            }
        </div>

        <div id="pageEmptyState" class="page-empty is-hidden">لم يتم العثور على أجهزة مطابقة.</div>
        }
        else
        {
        <div class="page-empty">لا توجد مناطق أو أجهزة متاحة لهذا الموظف.</div>
        }
    </div>
    }

    <form id="bulkForm" method="post" class="is-hidden">
        @Html.AntiForgeryToken()
        <input type="hidden" name="employeeId" value="@(Model?.Employee?.EmployeeId ?? 0)" />
        <div id="bulkInputsContainer"></div>
    </form>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
    const employeeRoutes = {
        assignBulk: '@Url.Action("AssignBulk", "Employees")',
        unassignBulk: '@Url.Action("UnassignBulk", "Employees")',
        delegateRegion: '@Url.Action("DelegateRegion", "Employees")',
        endDelegation: '@Url.Action("EndDelegation", "Employees")',
        cancelDelegation: '@Url.Action("CancelDelegation", "Employees")',
        autoAssignRegions: '@Url.Content("~/api/terminals/auto-assign-regions")'
    };

    const ACTIONS = {
        attach: 'attach',
        delegate: 'delegate',
        endDelegation: 'end-delegation',
        detach: 'detach'
    };

    const uiState = {
        action: null,
        region: 'all',
        query: '',
        deviceScope: 'all',
        delegation: {
            startDate: null,
            endDate: null,
            startDisplay: '',
            endDisplay: '',
            startCanonical: '',
            endCanonical: '',
            valid: false,
            message: 'يرجى اختيار تاريخ بداية الندب وتاريخ نهايته.'
        }
    };

    const ACTION_TEXT = {
        [ACTIONS.attach]: {
            help: 'اختر الأجهزة غير المرتبطة لتفعيل البصمة عليها للموظف.',
            button: count => count === 1 ? 'تفعيل البصمة على جهاز واحد' : `تفعيل البصمة على ${count} أجهزة`,
            title: 'تفعيل البصمة'
        },
        [ACTIONS.delegate]: {
            help: 'اختر الأجهزة وحدد فترة الندب قبل تفعيل الندب عليها.',
            button: count => count === 1 ? 'تفعيل الندب على جهاز واحد' : `تفعيل الندب على ${count} أجهزة`,
            title: 'ندب مؤقت'
        },
        [ACTIONS.endDelegation]: {
            help: 'اختر الأجهزة التي عليها ندب نشط أو مجدول لإلغائه.',
            button: count => count === 1 ? 'إلغاء الندب عن جهاز واحد' : `إلغاء الندب عن ${count} أجهزة`,
            title: 'إلغاء ندب'
        },
        [ACTIONS.detach]: {
            help: 'اختر الأجهزة المرتبطة حاليًا لإلغاء البصمة عنها.',
            button: count => count === 1 ? 'إلغاء البصمة عن جهاز واحد' : `إلغاء البصمة عن ${count} أجهزة`,
            title: 'إلغاء البصمة'
        }
    };

    let fpStart = null;
    let fpEnd = null;
    let lastAppliedEndMinDate; // guards against the infinite-recursion bug below

    function getEmployeeText() {
        const page = document.querySelector('.employees-search-page');
        const employeeId = (page?.dataset?.employeeId || '').trim();
        const employeeName = (page?.dataset?.employeeName || '').trim();
        if (employeeName && employeeId && employeeId !== '0') return `${employeeName} (${employeeId})`;
        if (employeeId && employeeId !== '0') return `الموظف رقم ${employeeId}`;
        return 'الموظف';
    }

    function saveRecentEmployee(employeeId) {
        try {
            let recent = JSON.parse(localStorage.getItem('ba_recent_employees') || '[]');
            recent = recent.filter(id => id !== String(employeeId));
            recent.unshift(String(employeeId));
            if (recent.length > 5) recent = recent.slice(0, 5);
            localStorage.setItem('ba_recent_employees', JSON.stringify(recent));
        } catch {}
    }

    function loadRecentEmployees() {
        try {
            const recent = JSON.parse(localStorage.getItem('ba_recent_employees') || '[]');
            const container = document.getElementById('recentEmployees');
            if (!container || recent.length === 0) return;
            container.style.display = '';
            container.innerHTML = '<span class="recent-chip-label">بحث سابق:</span>';
            recent.forEach(id => {
                const chip = document.createElement('button');
                chip.type = 'button';
                chip.className = 'recent-chip';
                chip.textContent = id;
                chip.addEventListener('click', () => fillAndSearch(id));
                container.appendChild(chip);
            });
        } catch {}
    }

    function fillAndSearch(employeeId) {
        const form = document.getElementById('employeeSearchForm');
        if (!form) return;
        const input = form.querySelector('input[name="employeeId"]');
        if (input) input.value = employeeId;
        form.submit();
    }

    function getSelectedCards() {
        return Array.from(document.querySelectorAll('.device-chk:checked'))
            .map(cb => cb.closest('.device-card'))
            .filter(Boolean)
            .filter(card => !card.classList.contains('is-hidden'));
    }

    function getSelectedTerminalIds() {
        return getSelectedCards()
            .map(card => (card.dataset.terminalId || '').trim())
            .filter(Boolean);
    }

    function clearSelection() {
        document.querySelectorAll('.device-chk').forEach(chk => {
            chk.checked = false;
            chk.closest('.device-card')?.classList.remove('is-selected');
        });
        updateBulkBar();
    }

    function formatDisplayDate(date) {
        const dd = String(date.getDate()).padStart(2, '0');
        const mm = String(date.getMonth() + 1).padStart(2, '0');
        const yyyy = date.getFullYear();
        return `${dd}/${mm}/${yyyy}`;
    }

    function formatCanonicalDate(date) {
        const dd = String(date.getDate()).padStart(2, '0');
        const mm = String(date.getMonth() + 1).padStart(2, '0');
        const yyyy = date.getFullYear();
        return `${yyyy}-${mm}-${dd}`;
    }

    function parseDisplayDate(value) {
        if (!value) return null;
        const match = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(value.trim());
        if (!match) return null;
        const [, dd, mm, yyyy] = match;
        return new Date(Number(yyyy), Number(mm) - 1, Number(dd));
    }

    function parseCanonicalDate(value) {
        if (!value) return null;
        const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value.trim());
        if (!match) return null;
        const [, yyyy, mm, dd] = match;
        return new Date(Number(yyyy), Number(mm) - 1, Number(dd));
    }

    function normalizeDate(date) {
        if (!(date instanceof Date) || Number.isNaN(date.getTime())) return null;
        return new Date(date.getFullYear(), date.getMonth(), date.getDate());
    }

    function getPickerDate(inputId, pickerRef) {
        const input = document.getElementById(inputId);
        const picker = pickerRef || input?._flatpickr;

        if (picker?.selectedDates?.length) {
            const selected = normalizeDate(picker.selectedDates[0]);
            if (selected) return selected;
        }

        const rawValue = (input?.value || '').trim();
        const canonical = parseCanonicalDate(rawValue);
        if (canonical) return canonical;

        const altValue = (picker?.altInput?.value || '').trim();
        const display = parseDisplayDate(altValue);
        if (display) return display;

        return null;
    }

    function syncDelegationState() {
        const startDate = getPickerDate('bulkStartDate', fpStart);
        const endDate = getPickerDate('bulkEndDate', fpEnd);
        const start = startDate ? formatDisplayDate(startDate) : '';
        const end = endDate ? formatDisplayDate(endDate) : '';
        const startCanonical = startDate ? formatCanonicalDate(startDate) : '';
        const endCanonical = endDate ? formatCanonicalDate(endDate) : '';

        let nextState = {
            startDate,
            endDate,
            startDisplay: start,
            endDisplay: end,
            startCanonical,
            endCanonical,
            valid: false,
            message: 'يرجى اختيار تاريخ بداية الندب وتاريخ نهايته.'
        };

        if (!start && !end) {
            uiState.delegation = nextState;
            return nextState;
        }
        if (!start) {
            nextState.message = 'يرجى اختيار تاريخ بداية الندب.';
            uiState.delegation = nextState;
            return nextState;
        }
        if (!end) {
            nextState.message = 'يرجى اختيار تاريخ نهاية الندب.';
            uiState.delegation = nextState;
            return nextState;
        }
        if (!startDate || !endDate) {
            nextState.message = 'صيغة التاريخ غير صحيحة.';
            uiState.delegation = nextState;
            return nextState;
        }
        if (endDate < startDate) {
            nextState.message = 'تاريخ النهاية يجب أن يكون بعد تاريخ البداية.';
            uiState.delegation = nextState;
            return nextState;
        }

        const diffDays = Math.floor((endDate - startDate) / 86400000) + 1;
        let durationText = `${diffDays} أيام`;
        if (diffDays === 1) durationText = 'يوم واحد';
        else if (diffDays === 2) durationText = 'يومان';

        nextState = {
            ...nextState,
            valid: true,
            message: `مدة الندب: ${durationText}`
        };
        uiState.delegation = nextState;
        return nextState;
    }

    function getDelegationState() {
        return syncDelegationState();
    }

    // Flatpickr must never be initialized while its container is display:none —
    // flatpickr caches the input's layout at init time, and if that layout was
    // 0x0 (because #delegateInlineFields was hidden), the calendar/altInput
    // render broken from then on, even after the container becomes visible.
    // So we show the container first (and force a reflow), then init once.
    function showDelegationFieldsBeforeInit() {
        const delegateFields = document.getElementById('delegateInlineFields');
        if (!delegateFields) return;
        delegateFields.classList.add('is-visible');
        delegateFields.setAttribute('aria-hidden', 'false');
        void delegateFields.offsetHeight; // force layout/reflow before flatpickr reads it
    }

    function initDelegationPickers() {
        if (fpStart && fpEnd) return; // already initialized

        fpStart = flatpickr('#bulkStartDate', {
            dateFormat: 'Y-m-d',
            altInput: true,
            altFormat: 'd/m/Y',
            allowInput: true,
            clickOpens: true,
            disableMobile: true,
            minDate: 'today',
            onChange: function (selectedDates, dateStr) {
                handleDelegationDatesChange(true);
            },
            onValueUpdate: function (selectedDates, dateStr) {
                handleDelegationDatesChange(true);
            },
            onClose: function () {
                handleDelegationDatesChange(true);
            }
        });
        fpEnd = flatpickr('#bulkEndDate', {
            dateFormat: 'Y-m-d',
            altInput: true,
            altFormat: 'd/m/Y',
            allowInput: true,
            clickOpens: true,
            disableMobile: true,
            minDate: 'today',
            onChange: function () {
                handleDelegationDatesChange(true);
            },
            onValueUpdate: function () {
                handleDelegationDatesChange(true);
            },
            onClose: function () {
                handleDelegationDatesChange(true);
            }
        });

        fpStart?.altInput?.addEventListener('blur', function () { handleDelegationDatesChange(true); });
        fpEnd?.altInput?.addEventListener('blur', function () { handleDelegationDatesChange(true); });
    }

    function handleDelegationDatesChange(resetSelection = true) {
        const delegation = syncDelegationState();

        // BUG FIX: fpEnd.set('minDate', ...) internally calls updateValue(true),
        // which fires fpEnd's own onChange/onValueUpdate — and those handlers call
        // this exact function again. Calling .set() unconditionally on every run
        // (including runs triggered by fpEnd's own date changing) created an
        // infinite loop: set() -> onValueUpdate -> handleDelegationDatesChange ->
        // set() -> ... This is what silently broke device selection after typing
        // both dates (the script hit "Maximum call stack size exceeded" mid-run).
        // Only call .set() when the min date is actually changing.
        if (fpEnd) {
            const nextMinDate = delegation.startCanonical || null;
            if (nextMinDate !== lastAppliedEndMinDate) {
                lastAppliedEndMinDate = nextMinDate;
                fpEnd.set('minDate', nextMinDate);
            }
        }

        if (resetSelection) {
            clearSelection();
        }

        renderPageState();
        return delegation;
    }

    function getEligibility(card) {
        const stateKey = (card.dataset.stateKey || '').trim();
        const delegation = getDelegationState();

        if (!uiState.action) {
            return { eligible: false, reason: '' };
        }

        if (uiState.action === ACTIONS.attach) {
            if (stateKey === 'unassigned') return { eligible: true, reason: '' };
            if (stateKey === 'assigned') return { eligible: false, reason: 'مرتبط مسبقًا' };
            return { eligible: false, reason: 'غير متاح لهذه العملية' };
        }

        if (uiState.action === ACTIONS.delegate) {
            if (!delegation.valid) return { eligible: false, reason: 'حدد فترة الندب أولًا' };
            if (stateKey === 'unassigned' || stateKey === 'assigned') return { eligible: true, reason: '' };
            if (stateKey === 'delegated_active') return { eligible: false, reason: 'يوجد ندب نشط' };
            if (stateKey === 'delegated_scheduled') return { eligible: false, reason: 'ندب مجدول' };
        }

        if (uiState.action === ACTIONS.endDelegation) {
            if (stateKey === 'delegated_active') return { eligible: true, reason: '' };
            if (stateKey === 'delegated_scheduled') return { eligible: true, reason: '' };
            return { eligible: false, reason: 'لا يوجد ندب لإلغائه' };
        }

        if (uiState.action === ACTIONS.detach) {
            if (stateKey === 'assigned') return { eligible: true, reason: '' };
            if (stateKey === 'delegated_active' || stateKey === 'delegated_scheduled') return { eligible: false, reason: 'مرتبط عبر ندب' };
            return { eligible: false, reason: 'غير مرتبط' };
        }

        return { eligible: false, reason: 'غير متاح لهذه العملية' };
    }

    function getWorkspaceMessage() {
        if (!uiState.action) return 'اختر العملية المطلوبة لتحديد الأجهزة.';
        if (uiState.action === ACTIONS.delegate) {
            const delegation = getDelegationState();
            if (!delegation.valid) return 'حدد تاريخ بداية ونهاية صحيحين لتتمكن من اختيار الأجهزة.';
        }
        return ACTION_TEXT[uiState.action]?.help || '';
    }

    function renderPageState() {
        const helpEl = document.getElementById('actionHelpText');
        const noteEl = document.getElementById('workspaceNote');
        const delegateFields = document.getElementById('delegateInlineFields');
        const delegateValidation = document.getElementById('delegateValidation');
        const pageEmpty = document.getElementById('pageEmptyState');
        const delegation = getDelegationState();

        if (helpEl) helpEl.textContent = getWorkspaceMessage();
        if (noteEl) {
            noteEl.textContent = getWorkspaceMessage();
            noteEl.classList.toggle('is-warning', !uiState.action || (uiState.action === ACTIONS.delegate && !delegation.valid));
        }

        if (delegateFields) {
            const visible = uiState.action === ACTIONS.delegate;
            delegateFields.classList.toggle('is-visible', visible);
            delegateFields.setAttribute('aria-hidden', String(!visible));
        }
        if (delegateValidation) {
            delegateValidation.textContent = delegation.message;
            delegateValidation.classList.toggle('is-valid', uiState.action === ACTIONS.delegate && delegation.valid);
            delegateValidation.classList.toggle('is-hidden', uiState.action !== ACTIONS.delegate || delegation.valid);
        }

        let anyVisibleDevice = false;
        document.querySelectorAll('.region-card').forEach(region => {
            const regionName = (region.dataset.regionName || '').trim();
            const matchesRegion = uiState.region === 'all' || uiState.region === regionName;
            const cards = region.querySelectorAll('.device-card');
            let visibleCount = 0;
            let availableCount = 0;

            cards.forEach(card => {
                const deviceName = (card.dataset.deviceName || '').toLowerCase();
                const terminalId = (card.dataset.terminalId || '').toLowerCase();
                const stateKey = (card.dataset.stateKey || '').trim();
                const matchesSearch = !uiState.query || deviceName.includes(uiState.query) || terminalId.includes(uiState.query);
                const matchesScope = uiState.deviceScope !== 'linked' || stateKey !== 'unassigned';
                const visible = matchesRegion && matchesSearch && matchesScope;
                const eligibility = getEligibility(card);
                const checkbox = card.querySelector('.device-chk');
                const note = card.querySelector('[data-device-note]');
                const interactive = !!uiState.action && eligibility.eligible;

                card.classList.toggle('is-hidden', !visible);
                card.classList.toggle('is-disabled', visible && !interactive);
                card.classList.toggle('is-interactive', visible && interactive);

                if (note) {
                    const showReason = !!uiState.action && !eligibility.eligible && !!eligibility.reason;
                    note.textContent = eligibility.reason || '';
                    note.classList.toggle('is-hidden', !showReason);
                }

                if (checkbox) {
                    checkbox.disabled = !visible || !interactive;
                    if (checkbox.disabled && checkbox.checked) {
                        checkbox.checked = false;
                        card.classList.remove('is-selected');
                    }
                }

                card.setAttribute('aria-disabled', String(!interactive));
                card.tabIndex = visible && interactive ? 0 : -1;
                if (visible) {
                    visibleCount++;
                    anyVisibleDevice = true;
                    if (interactive) availableCount++;
                }
            });

            region.classList.toggle('is-hidden', visibleCount === 0);
            region.querySelector('[data-region-available]')?.replaceChildren(document.createTextNode(`${availableCount} متاح`));

            const selectAll = region.querySelector('.select-all-region');
            const label = region.querySelector('[data-select-all-label]');
            const eligibleVisible = Array.from(region.querySelectorAll('.device-card:not(.is-hidden) .device-chk')).filter(chk => !chk.disabled);
            const checkedVisible = eligibleVisible.filter(chk => chk.checked);

            if (selectAll) {
                selectAll.disabled = eligibleVisible.length === 0;
                selectAll.checked = eligibleVisible.length > 0 && checkedVisible.length === eligibleVisible.length;
                selectAll.indeterminate = checkedVisible.length > 0 && checkedVisible.length < eligibleVisible.length;
            }
            if (label) label.textContent = `تحديد جميع الأجهزة المتاحة (${availableCount})`;
        });

        if (pageEmpty) {
            pageEmpty.classList.toggle('is-hidden', anyVisibleDevice);
        }

        updateBulkBar();
    }

    function updateBulkBar() {
        const bar = document.getElementById('bulkBar');
        const selectedCards = getSelectedCards();
        const count = selectedCards.length;
        const titleEl = document.getElementById('bulkTitle');
        const labelEl = document.getElementById('bulkLabel');
        const countEl = document.getElementById('selectedCount');
        const executeBtn = document.getElementById('bulkExecuteBtn');
        const delegation = getDelegationState();
        const canShow = !!uiState.action && count > 0 && (uiState.action !== ACTIONS.delegate || delegation.valid);

        if (countEl) countEl.textContent = String(count);

        if (!canShow) {
            bar?.classList.remove('show');
        } else {
            bar?.classList.add('show');
        }

        const title = ACTION_TEXT[uiState.action]?.title || 'العملية';
        if (titleEl) {
            titleEl.textContent = count > 0
                ? (count === 1 ? 'تم تحديد جهاز واحد' : `تم تحديد ${count} أجهزة`)
                : 'لا توجد أجهزة محددة';
        }

        if (labelEl) {
            if (!uiState.action) labelEl.textContent = 'اختر العملية ثم حدّد الأجهزة المناسبة لها.';
            else if (count === 0) labelEl.textContent = 'حدد الأجهزة التي تريد تنفيذ العملية عليها.';
            else labelEl.textContent = title;
        }

        if (executeBtn) {
            executeBtn.disabled = !canShow;
            executeBtn.textContent = ACTION_TEXT[uiState.action]?.button(count) || 'تنفيذ العملية';
        }
    }

    function updateCardSelection(checkbox) {
        const card = checkbox.closest('.device-card');
        if (!card) return;
        card.classList.toggle('is-selected', checkbox.checked);
        updateBulkBar();
        renderPageState();
    }

    function handleRegionSelectAll(selectAll) {
        const regionCard = selectAll?.closest('.region-card');
        if (!regionCard) return;

        const eligibleVisible = Array
            .from(regionCard.querySelectorAll('.device-card:not(.is-hidden) .device-chk'))
            .filter(chk => !chk.disabled);

        if (eligibleVisible.length === 0) {
            selectAll.checked = false;
            selectAll.indeterminate = false;
            renderPageState();
            return;
        }

        eligibleVisible.forEach(chk => {
            chk.checked = selectAll.checked;
            chk.closest('.device-card')?.classList.toggle('is-selected', chk.checked);
        });

        updateBulkBar();
        renderPageState();
    }

    function toggleRegionCollapse(collapseId) {
        const body = document.getElementById(collapseId);
        const header = document.querySelector(`[data-collapse-target="${collapseId}"]`);
        if (!body || !header) return;
        const expanded = header.getAttribute('aria-expanded') === 'true';
        header.setAttribute('aria-expanded', String(!expanded));
        body.classList.toggle('show', !expanded);
    }

    function expandAllRegions() {
        document.querySelectorAll('.region-body').forEach(body => body.classList.add('show'));
        document.querySelectorAll('.region-header').forEach(header => header.setAttribute('aria-expanded', 'true'));
    }

    function collapseAllRegions() {
        document.querySelectorAll('.region-body').forEach(body => body.classList.remove('show'));
        document.querySelectorAll('.region-header').forEach(header => header.setAttribute('aria-expanded', 'false'));
    }

    function fillAndSubmitBulkForm(actionUrl, fields) {
        const form = document.getElementById('bulkForm');
        const container = document.getElementById('bulkInputsContainer');
        if (!form || !container) return;
        form.action = actionUrl;
        container.innerHTML = '';

        (fields || []).forEach(f => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = f.name;
            input.value = f.value;
            container.appendChild(input);
        });

        form.submit();
    }

    async function bulkExecute() {
        const selectedIds = getSelectedTerminalIds();
        const selectedCards = getSelectedCards();
        if (!uiState.action) {
            await Swal.fire({ icon: 'warning', title: 'تنبيه', text: 'يرجى اختيار العملية أولًا', confirmButtonColor: '#692f39', confirmButtonText: 'حسنًا' });
            return;
        }
        if (selectedIds.length === 0) {
            await Swal.fire({ icon: 'warning', title: 'تنبيه', text: 'يرجى تحديد جهاز واحد على الأقل', confirmButtonColor: '#692f39', confirmButtonText: 'حسنًا' });
            return;
        }

        const employeeText = getEmployeeText();
        const count = selectedIds.length;
        const delegation = getDelegationState();
        let actionUrl = '';
        let fields = selectedIds.map(x => ({ name: 'terminalIds', value: x }));
        let title = '';
        let text = '';
        let confirmText = '';
        let icon = 'question';

        if (uiState.action === ACTIONS.attach) {
            title = 'تأكيد ربط الأجهزة';
            text = `سيتم تفعيل بصمة ${employeeText} على ${count} جهاز.`;
            confirmText = ACTION_TEXT[ACTIONS.attach].button(count);
            actionUrl = employeeRoutes.assignBulk;
        } else if (uiState.action === ACTIONS.delegate) {
            if (!delegation.valid) {
                await Swal.fire({ icon: 'warning', title: 'تنبيه', text: delegation.message, confirmButtonColor: '#692f39', confirmButtonText: 'حسنًا' });
                return;
            }
            title = 'تأكيد إنشاء الندب';
            text = `سيتم تفعيل ندب ${employeeText} على ${count} جهاز من ${delegation.startDisplay} إلى ${delegation.endDisplay}.`;
            confirmText = ACTION_TEXT[ACTIONS.delegate].button(count);
            actionUrl = employeeRoutes.delegateRegion;
            fields.push({ name: 'startDate', value: delegation.startCanonical });
            fields.push({ name: 'endDate', value: delegation.endCanonical });
        } else if (uiState.action === ACTIONS.endDelegation) {
            const activeCards = selectedCards.filter(card => (card.dataset.stateKey || '').trim() === 'delegated_active');
            const scheduledCards = selectedCards.filter(card => (card.dataset.stateKey || '').trim() === 'delegated_scheduled');

            if (activeCards.length > 0 && scheduledCards.length > 0) {
                await Swal.fire({
                    icon: 'warning',
                    title: 'تنبيه',
                    text: 'لا يمكن إلغاء ندب نشط ومجدول معًا في نفس العملية. اختر نوعًا واحدًا فقط في كل مرة.',
                    confirmButtonColor: '#692f39',
                    confirmButtonText: 'حسنًا'
                });
                return;
            }

            title = 'تأكيد إلغاء الندب';
            confirmText = ACTION_TEXT[ACTIONS.endDelegation].button(count);
            icon = 'warning';

            if (scheduledCards.length > 0) {
                const delegationIds = Array.from(new Set(
                    scheduledCards
                        .map(card => (card.dataset.delegationId || '').trim())
                        .filter(Boolean)
                ));

                if (delegationIds.length !== 1) {
                    await Swal.fire({
                        icon: 'warning',
                        title: 'تنبيه',
                        text: 'يمكن إلغاء ندب مجدول واحد فقط في كل مرة. اختر أجهزة من نفس الندب المجدول فقط.',
                        confirmButtonColor: '#692f39',
                        confirmButtonText: 'حسنًا'
                    });
                    return;
                }

                actionUrl = employeeRoutes.cancelDelegation;
                fields = [{ name: 'delegationId', value: delegationIds[0] }];
                text = count === 1
                    ? 'سيتم إلغاء الندب المجدول عن الجهاز المحدد.'
                    : `سيتم إلغاء الندب المجدول المرتبط بـ ${count} أجهزة.`;
            } else {
                actionUrl = employeeRoutes.endDelegation;
                fields = selectedIds.map(x => ({ name: 'terminalIds', value: x }));
                text = `سيتم إنهاء الندب النشط عن ${count} جهاز فورًا.`;
            }
        } else if (uiState.action === ACTIONS.detach) {
            title = 'تأكيد إلغاء البصمة';
            text = `سيتم إلغاء بصمة ${employeeText} عن ${count} جهاز.`;
            confirmText = ACTION_TEXT[ACTIONS.detach].button(count);
            actionUrl = employeeRoutes.unassignBulk;
            icon = 'warning';
        } else {
            return;
        }

        const result = await Swal.fire({
            title,
            text,
            icon,
            showCancelButton: true,
            confirmButtonColor: '#692f39',
            cancelButtonColor: '#6b7280',
            confirmButtonText: confirmText,
            cancelButtonText: 'إلغاء'
        });

        if (!result.isConfirmed) return;
        fillAndSubmitBulkForm(actionUrl, fields);
    }

    async function confirmDelegationScopeAction(button, scope) {
        const form = button.closest('form');
        if (!form) return;

        const employeeText = getEmployeeText();
        const terminalIds = Array.from(form.querySelectorAll('input[name="terminalIds"]'))
            .map(input => (input.value || '').trim())
            .filter(Boolean);
        const regionCard = button.closest('.region-card');
        const regionName = (regionCard?.dataset?.regionName || '').trim();

        const result = await Swal.fire({
            title: 'تأكيد إلغاء الندب',
            text: scope === 'region'
                ? `سيتم إنهاء الندب النشط عن ${terminalIds.length} جهاز في منطقة ${regionName || 'محددة'}.`
                : 'سيتم إنهاء الندب النشط عن الجهاز المحدد.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#692f39',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'إلغاء الندب',
            cancelButtonText: 'إلغاء'
        });

        if (result.isConfirmed) form.submit();
    }

    document.addEventListener('DOMContentLoaded', function () {
        loadRecentEmployees();

        const searchForm = document.getElementById('employeeSearchForm');
        if (searchForm) {
            searchForm.addEventListener('submit', function () {
                const input = searchForm.querySelector('input[name="employeeId"]');
                const val = (input?.value || '').trim();
                if (val && val !== '0') saveRecentEmployee(val);
                const btn = searchForm.querySelector('button[type="submit"]');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i><span>جاري البحث...</span>';
                }
            });
        }

        document.querySelectorAll('input[name="pageAction"]').forEach(input => {
            input.addEventListener('change', function () {
                uiState.action = this.value || null;
                clearSelection();
                if (uiState.action === ACTIONS.delegate) {
                    showDelegationFieldsBeforeInit();
                    initDelegationPickers();
                    handleDelegationDatesChange(false);
                } else {
                    renderPageState();
                }
            });
        });

        document.getElementById('regionSelect')?.addEventListener('change', function () {
            uiState.region = this.value || 'all';
            if (uiState.region !== 'all') {
                const region = Array.from(document.querySelectorAll('.region-card')).find(card => card.dataset.regionName === uiState.region);
                const body = region?.querySelector('.region-body');
                const header = region?.querySelector('.region-header');
                if (body && header) {
                    body.classList.add('show');
                    header.setAttribute('aria-expanded', 'true');
                }
            }
            renderPageState();
        });

        document.getElementById('deviceLiveSearch')?.addEventListener('input', function () {
            uiState.query = (this.value || '').trim().toLowerCase();
            renderPageState();
        });
        document.getElementById('deviceScopeSelect')?.addEventListener('change', function () {
            uiState.deviceScope = this.value || 'all';
            clearSelection();
            renderPageState();
        });

        document.getElementById('bulkClearSelectionBtn')?.addEventListener('click', clearSelection);
        document.getElementById('bulkExecuteBtn')?.addEventListener('click', bulkExecute);
        document.getElementById('expandRegionsBtn')?.addEventListener('click', expandAllRegions);
        document.getElementById('collapseRegionsBtn')?.addEventListener('click', collapseAllRegions);

        document.querySelectorAll('.region-header').forEach(header => {
            header.addEventListener('click', function () {
                toggleRegionCollapse(this.dataset.collapseTarget);
            });
        });

        document.querySelectorAll('.device-card').forEach(card => {
            const checkbox = card.querySelector('.device-chk');
            checkbox?.addEventListener('change', function () {
                updateCardSelection(this);
            });
            card.addEventListener('click', function (e) {
                if (!checkbox || checkbox.disabled) return;
                if (e.target === checkbox) return;
                checkbox.checked = !checkbox.checked;
                updateCardSelection(checkbox);
            });
            card.addEventListener('keydown', function (e) {
                if (!checkbox || checkbox.disabled) return;
                if (e.key !== 'Enter' && e.key !== ' ') return;
                e.preventDefault();
                checkbox.checked = !checkbox.checked;
                updateCardSelection(checkbox);
            });
        });

        document.querySelectorAll('.select-all-region').forEach(selectAll => {
            selectAll.addEventListener('click', function (e) {
                e.stopPropagation();
            });
            selectAll.addEventListener('change', function () {
                handleRegionSelectAll(this);
            });
        });

        document.querySelectorAll('[data-delegation-scope="region"]').forEach(button => {
            button.addEventListener('click', function () {
                confirmDelegationScopeAction(this, 'region');
            });
        });

        document.getElementById('autoAssignBtn')?.addEventListener('click', async () => {
            const confirmResult = await Swal.fire({
                title: 'تأكيد إجراء إداري',
                text: 'سيتم إعادة بناء توزيع الأجهزة تلقائيًا على المناطق.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#692f39',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'تشغيل',
                cancelButtonText: 'إلغاء'
            });

            if (!confirmResult.isConfirmed) return;

            const res = await fetch(employeeRoutes.autoAssignRegions, { method: 'POST' });
            if (res.status === 403) {
                await Swal.fire({ icon: 'error', title: 'غير مصرح', text: 'غير مصرح لك (مدير فقط).' });
                return;
            }

            const data = await res.json();
            await Swal.fire({
                icon: 'success',
                title: 'تم التنفيذ',
                html: `<div class="c-swal-meta">
                        <div>عدد الأجهزة: <strong>${data.totalDevices ?? '-'}</strong></div>
                        <div>جديد: <strong>${data.inserted ?? data.newlyAssigned ?? '-'}</strong></div>
                        <div>تم تعديلها: <strong>${data.updated ?? data.updatedRegions ?? '-'}</strong></div>
                    </div>`,
                confirmButtonColor: '#692f39'
            });
        });

        syncDelegationState();
        renderPageState();
    });
</script>
}
